PORT=3000

# REQUIRED — the app fails fast at boot if this is not set. Shared secret
# required in the x-admin-key header to call the admin financial report and
# delete-user endpoints. Set a strong, random value here (or in your real
# deployment environment) — never commit a real working value.
ADMIN_API_KEY=<set-a-strong-admin-key>

BCRYPT_SALT_ROUNDS=10
