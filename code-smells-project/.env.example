# Copy this file to `.env` and fill in real values for local development.
# Never commit the real `.env` file.

# Flask session-signing key. Required for production; if omitted, a random
# key is generated at process start (sessions won't survive a restart).
SECRET_KEY=change-me-to-a-long-random-value

# Set to "true" only for local development. Must stay "false" in production.
FLASK_DEBUG=false

# Path to the SQLite database file.
DB_PATH=loja.db

# Token required in the `X-Admin-Token` header to call /admin/* endpoints.
ADMIN_TOKEN=change-me-to-a-long-random-admin-token

HOST=0.0.0.0
PORT=5000
